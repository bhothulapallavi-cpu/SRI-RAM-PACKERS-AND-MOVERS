<!DOCTYPE html>
<html lang="kn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SRI RAM PACKERS AND MOVERS - Register Your Home</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Arial,sans-serif}
body{background:#FFF3E6;padding:15px}
.top{background:#fff;padding:18px;border-radius:15px;text-align:center;box-shadow:0 2px 10px #ddd}
.top h1{color:#E65100;font-size:24px;line-height:1.3}
.top p{color:#666;font-size:13px;margin-top:5px}
.top .call{background:#E65100;color:#fff;display:inline-block;padding:8px 18px;border-radius:20px;margin-top:10px;font-weight:bold;text-decoration:none}
.card{background:#fff;margin-top:15px;padding:20px;border-radius:20px;box-shadow:0 2px 15px #ddd}
.card h2{text-align:center;font-size:24px}
.card .sub{text-align:center;color:#E65100;margin:5px 0 20px;font-weight:bold}
label{font-weight:bold;display:block;margin:15px 0 8px;font-size:15px}
label span{font-weight:normal;color:#777;font-size:13px}
.row{display:flex;gap:10px}
.row div{flex:1}
input,select{width:100%;padding:12px;border:1px solid #ddd;border-radius:10px;font-size:15px;background:#F8F8F8;outline:none}
input:focus{border-color:#E65100;background:#fff}
.types{display:flex;gap:8px}
.type{flex:1;text-align:center;padding:12px;border:1px solid #ddd;border-radius:10px;cursor:pointer;background:#F8F8F8;font-weight:bold}
.type.active{background:#E65100;color:#fff;border-color:#E65100}
.lift{display:flex;gap:8px}
.lift button{flex:1;padding:11px;border:1px solid #ddd;border-radius:10px;background:#F8F8F8;font-weight:bold;cursor:pointer}
.lift button.active{background:#E65100;color:#fff}
.items{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.item{display:flex;align-items:center;gap:10px;padding:12px;border:1px solid #eee;border-radius:12px;background:#FFF8F0;cursor:pointer}
.item input{width:20px;height:20px;accent-color:#E65100}
.item span{font-size:20px}
.btn{width:100%;background:#E65100;color:#fff;border:none;padding:16px;border-radius:12px;font-size:18px;font-weight:bold;margin-top:20px;cursor:pointer}
.btn:active{transform:scale(0.98)}
.note{text-align:center;color:#777;font-size:12px;margin-top:12px}
.success{display:none;background:#E8F5E9;padding:15px;border-radius:12px;text-align:center;margin-top:15px;color:#2E7D32;font-weight:bold;line-height:1.5}
</style>
</head>
<body>

<div class="top">
  <h1>🙏 SRI RAM<br>PACKERS AND MOVERS</h1>
  <p>Bengaluru • House Shifting • ಮನೆ ಶಿಫ್ಟ್</p>
  <a class="call" href="tel:+919999999999">📞 Call Now</a>
</div>

<div class="card">
  <h2>Register Your Home</h2>
  <p class="sub">ನಿಮ್ಮ ಮನೆ ನೋಂದಾಯಿಸಿ</p>

  <label>House Type • ಮನೆಯ ಪ್ರಕಾರ</label>
  <div class="types" id="houseTypes">
    <div class="type active" onclick="selectType(this)">1 BHK</div>
    <div class="type" onclick="selectType(this)">2 BHK</div>
    <div class="type" onclick="selectType(this)">3 BHK</div>
    <div class="type" onclick="selectType(this)">Villa</div>
  </div>

  <div class="row">
    <div>
      <label>Rooms • <span>ಕೋಣೆಗಳು</span></label>
      <input type="number" id="rooms" placeholder="e.g. 2" value="2">
    </div>
    <div>
      <label>Floor • <span>ಮಹಡಿ</span></label>
      <select id="floor">
        <option>Ground Floor</option>
        <option>1st Floor</option>
        <option>2nd Floor</option>
        <option selected>3rd Floor</option>
        <option>4th Floor</option>
        <option>5th+ Floor</option>
      </select>
    </div>
  </div>

  <label>Lift Available? • ಲಿಫ್ಟ್ ಇದೆಯೇ?</label>
  <div class="lift" id="liftBtns">
    <button type="button" class="active" onclick="selectLift(this)">Yes • ಇದೆ</button>
    <button type="button" onclick="selectLift(this)">No • ಇಲ್ಲ</button>
  </div>

  <label>Items Checklist • ಸಾಮಾನುಗಳ ಪಟ್ಟಿ <span>- Tick Madi</span></label>
  <div class="items">
    <label class="item"><input type="checkbox" checked> <span>🧊</span> Fridge</label>
    <label class="item"><input type="checkbox" checked> <span>👕</span> Washing Machine</label>
    <label class="item"><input type="checkbox" checked> <span>🛋️</span> Sofa</label>
    <label class="item"><input type="checkbox"> <span>🛏️</span> Bed / Cot</label>
    <label class="item"><input type="checkbox"> <span>📺</span> TV</label>
    <label class="item"><input type="checkbox" checked> <span>🍽️</span> Dining Table</label>
    <label class="item"><input type="checkbox"> <span>🚪</span> Cupboard</label>
    <label class="item"><input type="checkbox"> <span>🖥️</span> Computer</label>
  </div>

  <label>Boxes Count • <span>ಪೆಟ್ಟಿಗೆಗಳ ಸಂಖ್ಯೆ</span></label>
  <div class="row">
    <div><input type="number" id="boxes" value="5" placeholder="e.g. 5"></div>
  </div>

  <label>Pickup Address • ಹಳೆಯ ಮನೆ ವಿಳಾಸ</label>
  <input type="text" id="pickup" placeholder="e.g. Koramangala, Bangalore">

  <label>Delivery Address • ಹೊಸ ಮನೆ ವಿಳಾಸ</label>
  <input type="text" id="delivery" placeholder="e.g. HSR Layout, Bangalore">

  <label>Phone Number • ದೂರವಾಣಿ ಸಂಖ್ಯೆ</label>
  <input type="tel" id="phone" placeholder="+91 98XXX XXXXX">

  <label>Date • <span>ಯಾವಾಗ ಶಿಫ್ಟ್ ಮಾಡಬೇಕು?</span></label>
  <input type="date" id="date">

  <button class="btn" onclick="registerHome()">Register Home Now • ಈಗಲೇ ನೋಂದಾಯಿಸಿ</button>

  <div class="success" id="successMsg">✅ Register Ayitu!</div>

  <p class="note">Trusted by 10,000+ families in Bangalore • ಬೆಂಗಳೂರಿನ 10,000+ ಕುಟುಂಬಗಳ ವಿಶ್ವಾಸ</p>
</div>

<script>
let selectedType = "1 BHK";
let selectedLift = "Yes";
function selectType(el){
  document.querySelectorAll('.type').forEach(t=>t.classList.remove('active'));
  el.classList.add('active');
  selectedType = el.innerText;
}
function selectLift(el){
  document.querySelectorAll('#liftBtns button').forEach(b=>b.classList.remove('active'));
  el.classList.add('active');
  selectedLift = el.innerText;
}
function registerHome(){
  let rooms = document.getElementById('rooms').value;
  let pickup = document.getElementById('pickup').value;
  let delivery = document.getElementById('delivery').value;
  let phone = document.getElementById('phone').value;
  if(!pickup || !delivery || !phone){
    alert("Please fill Pickup, Delivery & Phone - ದಯವಿಟ್ಟು ಎಲ್ಲಾ ತುಂಬಿ");
    return;
  }
  let items = [];
  document.querySelectorAll('.item input:checked').forEach(c=>{
    items.push(c.parentElement.innerText.trim());
  });
  document.getElementById('successMsg').style.display = "block";
  document.getElementById('successMsg').innerHTML = "✅ Register Ayitu!<br>"+selectedType+" | Rooms: "+rooms+" | Lift: "+selectedLift+"<br>Items: "+items.join(", ")+"<br>SRI RAM PACKERS will call you soon!";
  window.scrollTo(0, document.body.scrollHeight);
}
</script>

</body>
</html>
